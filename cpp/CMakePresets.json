{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    { "name": "base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}" },
    { "name": "debug", "displayName": "Debug", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MSID_COPY_PLUGINS": "OFF" } },
    { "name": "release", "displayName": "Release", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "core", "displayName": "Core + tests only (no JUCE)", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MSID_BUILD_PLUGIN": "OFF" } }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "core", "configurePreset": "core" }
  ],
  "testPresets": [
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
